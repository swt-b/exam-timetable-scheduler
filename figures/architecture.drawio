<mxfile host="app.diagrams.net" type="device">
  <diagram name="System Architecture" id="arch1">
    <mxGraphModel dx="1050" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="System Architecture" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1a1f36;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="340" height="30" as="geometry" />
        </mxCell>

        <mxCell id="data" value="Kaggle dataset&#10;(6 CSV files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pre" value="import_kaggle.py&#10;preprocessing (join 6 CSVs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#818cf8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="load" value="dataio.py&#10;load + clean + validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#818cf8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="engine" value="engine.py  (CSP solver)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1f36;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="380" height="320" as="geometry" />
        </mxCell>
        <mxCell id="cc" value="constraint checker&#10;(6 hard constraints)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="160" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sc" value="soft-constraint scorer&#10;(quality 0-100)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="160" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="solver" value="backtracking solver&#10;(MRV + forward checking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="240" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="exp" value="explainer&#10;(why each placement)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="240" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out" value="clash-free timetable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#818cf8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="330" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="resc" value="reschedule.py&#10;repair on disruption" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="120" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="app" value="app.py&#10;web interface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#818cf8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="230" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="cli.py + viz.py&#10;terminal + HTML output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#818cf8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="340" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="data" target="pre"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="pre" target="load"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="load" target="engine"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="engine" target="resc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="engine" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="engine" target="cli"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
