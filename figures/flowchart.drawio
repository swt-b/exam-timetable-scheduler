<mxfile host="app.diagrams.net" type="device">
  <diagram name="Solver Flowchart" id="flow1">
    <mxGraphModel dx="900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="START&#10;all exams unscheduled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1f36;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="all exams placed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="150" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="done" value="DONE&#10;valid timetable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="175" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mrv" value="MRV: pick the exam with&#10;the fewest legal options" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#818cf8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="300" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="any unplaced exam&#10;has 0 options?&#10;(forward checking)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="410" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="NO valid&#10;timetable exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dc2626;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="440" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="vo" value="value ordering:&#10;try the kindest slot/room first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#818cf8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="570" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="place" value="place the exam,&#10;solve the rest (recursion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="680" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="did it lead&#10;to success?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="790" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="back" value="backtrack:&#10;undo, try next option" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="950" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;fontColor=#059669;fontStyle=1;" edge="1" parent="1" source="d1" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;fontColor=#1a1f36;fontStyle=1;" edge="1" parent="1" source="d1" target="mrv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="mrv" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;fontColor=#dc2626;fontStyle=1;" edge="1" parent="1" source="d2" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;fontColor=#1a1f36;fontStyle=1;" edge="1" parent="1" source="d2" target="vo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="vo" target="place"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="place" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" value="no -> backtrack" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;fontColor=#d97706;fontStyle=1;" edge="1" parent="1" source="d3" target="back"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a1f36;strokeWidth=2;endArrow=block;fontColor=#059669;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="done">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="785" y="845" />
              <mxPoint x="785" y="205" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
